---
exclude_paths:
  # Installed collections are third-party code.
  - collections/

  # SOPS owns these files' formatting entirely: the leading "#ENC[...]" comment
  # and the 200+ character ciphertext lines are generated, not authored, and
  # reformatting them would corrupt the file. That they are genuinely encrypted
  # is verified by the 'secrets' job in .github/workflows/validate.yml instead.
  #
  # Glob rather than one entry per group, so a new host group does not silently
  # start failing lint.
  - "inventory/group_vars/*/secrets.sops.yaml"
